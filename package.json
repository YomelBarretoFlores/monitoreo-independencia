{
  "name": "monitoreo-independencia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "build:vercel": "npm run build && node scripts/build-vercel.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "collect": "node server/collect-once.ts",
    "format": "prettier --write .",
    "start": "node server/index.ts",
    "build:sim": "node scripts/sim/build.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@vercel/functions": "3.10.3",
    "fast-xml-parser": "^5.12.0",
    "maplibre-gl": "6.15.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
